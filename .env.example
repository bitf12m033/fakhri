# Root-level env reference. Real secrets NEVER committed; copy to the relevant app .env.
# Apps read their own .env (see apps/api/.env.example, apps/web/.env.example).

# PostgreSQL (local dev / docker-compose)
DATABASE_URL=postgresql://fakhri:fakhri_dev@localhost:5432/fakhri

# Redis
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1