NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://fakhri:fakhri_dev@localhost:5432/fakhri
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
# The storefront calls the API from its server, so without this every shopper shares one
# rate-limit bucket (increment 3.8). Set it ONLY when a reverse proxy in front of the
# storefront appends X-Forwarded-For (Caddy and nginx's $proxy_add_x_forwarded_for do):
# Next.js keeps a client-supplied header as-is, so with the storefront exposed directly a
# shopper could pick their own address. Never a bare hop count.
# TRUST_PROXY=loopback

# Auth (increment 3.4). Generate per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-32-byte-random-hex-string
JWT_ISSUER=fakhri-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
RATE_LIMIT_AUTH_PER_MINUTE=10

# Payments, shipping, notifications (increment 3.6)
PAYMENT_MOCK_SECRET=mock-gateway-dev-secret-0000
PAYMENT_RETURN_URL=http://localhost:3001/checkout/return
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=20
NOTIFICATIONS_CHANNEL=console

# Invoice header (FBR fields)
SELLER_NAME=Fakhri Electronics
SELLER_NTN=0000000-0
SELLER_ADDRESS=Lahore, Pakistan
SELLER_PHONE=+924200000000

# Storefront cache revalidation (increment 3.8). Off while unset; when on, use the
# same secret as REVALIDATE_SECRET in apps/web.
# WEB_REVALIDATE_URL=http://localhost:3001/internal/revalidate
# WEB_REVALIDATE_SECRET=replace-me-with-the-same-32-plus-char-secret-as-web
