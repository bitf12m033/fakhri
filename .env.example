# Root-level env reference. Real secrets NEVER committed; copy to the relevant app .env.
# Apps read their own .env (see apps/api/.env.example, apps/web/.env.example).

# PostgreSQL (local dev / docker-compose)
DATABASE_URL=postgresql://fakhri:fakhri_dev@localhost:5432/fakhri

# Redis
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Auth (increment 3.4). Generate per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-32-byte-random-hex-string
JWT_ISSUER=fakhri-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
RATE_LIMIT_AUTH_PER_MINUTE=10
