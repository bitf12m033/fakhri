# Where the storefront server reaches the API. The browser never calls the API
# directly: session-bound calls go through /bff (increment 3.8).
API_URL=http://localhost:3000

# Public origin, for canonical URLs, the sitemap and JSON-LD.
SITE_URL=http://localhost:3001

# On-demand revalidation (REQ-10). Must match the API's WEB_REVALIDATE_SECRET;
# 32+ characters. Unset disables /internal/revalidate (pages still expire on their own).
# REVALIDATE_SECRET=

# Development and staging only: lets /checkout/return stand in for the mock payment
# provider and sign its callback. Same value as the API's PAYMENT_MOCK_SECRET.
# Production must leave this unset.
PAYMENT_MOCK_SECRET=mock-gateway-dev-secret-0000
