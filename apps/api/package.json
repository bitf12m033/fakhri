{
  "name": "@fakhri/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @fakhri/shared && npm run build -w @fakhri/config && npm run build -w @fakhri/prisma && nest build",
    "typecheck": "npm run build -w @fakhri/shared && npm run build -w @fakhri/config && npm run build -w @fakhri/prisma && tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fakhri/config": "*",
    "@fakhri/prisma": "*",
    "@fakhri/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.9"
  }
}
